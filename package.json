{
  "name": "@honu/core",
  "version": "0.5.0",
  "description": "honu — Koa's ergonomics at Hono's speed: dual-mode onion framework for Bun 1.4+ (runs under Node too). Zero dependencies, precompiled middleware chains, hybrid static/trie router, Bun-native route sinking, signed cookies, SSE, WebSockets.",
  "keywords": [
    "bun",
    "web",
    "framework",
    "http",
    "server",
    "router",
    "middleware",
    "onion",
    "hono",
    "koa",
    "fetch",
    "typescript",
    "zero-dependency",
    "websockets",
    "sse"
  ],
  "homepage": "https://github.com/renxqoo/honu#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/renxqoo/honu.git"
  },
  "bugs": {
    "url": "https://github.com/renxqoo/honu/issues"
  },
  "license": "MIT",
  "files": [
    "dist",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./middleware": {
      "types": "./dist/middleware/index.d.ts",
      "import": "./dist/middleware/index.js"
    },
    "./middleware/*": {
      "types": "./dist/middleware/*.d.ts",
      "import": "./dist/middleware/*.js"
    },
    "./package.json": "./package.json",
    "./node": {
      "types": "./dist/adapters/node.d.ts",
      "import": "./dist/adapters/node.js"
    }
  },
  "scripts": {
    "build": "tsc --noEmit && rm -rf dist && tsc -p tsconfig.build.json && find dist \\( -name '*.js' -o -name '*.d.ts' \\) -exec sed -i '' 's/\\.ts\\\"/.js\\\"/g' {} +",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "test": "vitest run",
    "test:bun": "bun --bun x vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "bench": "node bench/run.mjs",
    "smoke": "bun scripts/smoke.ts",
    "verify": "oxfmt --check && oxlint && tsc --noEmit && vitest run --coverage",
    "soak": "bun scripts/soak.ts",
    "example:check": "bun scripts/example-check.ts"
  },
  "devDependencies": {
    "@koa/router": "^15.7.0",
    "@types/bun": "1.4.0",
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "4.1.11",
    "autocannon": "8.0.0",
    "fastify": "^5.12.1",
    "hono": "4.13.5",
    "koa": "3.2.1",
    "oxfmt": "0.65.0",
    "oxlint": "1.80.0",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  },
  "engines": {
    "bun": ">=1.4.0"
  },
  "publint": {
    "run": true
  },
  "publishConfig": {
    "access": "public"
  }
}
