{
  "name": "honu",
  "version": "0.5.0",
  "description": "High-performance onion-model web framework for Bun 1.4+. Zero dependencies, precompiled middleware chains, hybrid static/trie router, Bun-native route sinking (Bun.serve routes table), Bun.password/Bun.CSRF components. At parity or faster than Hono on Bun.",
  "license": "MIT",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./middleware": {
      "types": "./dist/middleware/index.d.ts",
      "import": "./dist/middleware/index.js"
    },
    "./middleware/*": {
      "types": "./dist/middleware/*.d.ts",
      "import": "./dist/middleware/*.js"
    },
    "./adapters/*": {
      "types": "./dist/adapters/*.d.ts",
      "import": "./dist/adapters/*.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc --noEmit && rm -rf dist && tsc -p tsconfig.build.json && find dist \\( -name '*.js' -o -name '*.d.ts' \\) -exec sed -i '' 's/\\.ts\\\"/.js\\\"/g' {} +",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "test": "vitest run",
    "test:bun": "bun --bun x vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "bench": "node bench/run.mjs",
    "smoke": "bun scripts/smoke.ts",
    "verify": "oxfmt --check && oxlint && tsc --noEmit && vitest run --coverage",
    "soak": "bun scripts/soak.ts",
    "example:check": "bun scripts/example-check.ts"
  },
  "devDependencies": {
    "@koa/router": "^15.7.0",
    "@types/bun": "1.4.0",
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "4.1.11",
    "autocannon": "8.0.0",
    "fastify": "^5.12.1",
    "hono": "4.13.5",
    "koa": "3.2.1",
    "oxfmt": "0.65.0",
    "oxlint": "1.80.0",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  },
  "engines": {
    "bun": ">=1.4.0"
  },
  "publint": {
    "run": true
  }
}
